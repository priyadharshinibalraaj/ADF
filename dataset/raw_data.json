{
	"name": "raw_data",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"folderPath": {
				"type": "String"
			},
			"fileName": {
				"type": "String"
			}
		},
		"annotations": [],
