			},
			{
				"name": "BloodType",
				"type": "String"
			},
			{
				"name": "Diagnosis",
				"type": "String"
			},
			{
				"name": "Treatment",
				"type": "String"
			},
			{
				"name": "AdmissionDate",
				"type": "String"
			},
			{
				"name": "DischargeDate",
