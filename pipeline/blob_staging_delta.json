{
	"name": "blob_staging_delta",
	"properties": {
		"activities": [
			{
				"name": "Get Metadata from Blob",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"typeProperties": {
					"dataset": {
						"referenceName": "DelimitedText2",
						"type": "DatasetReference"
					},
					"fieldList": [],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"parameters": {
			"date": {
				"type": "string",
				"defaultValue": "2025-08-21"
			},
			"source_path": {
				"type": "string",
				"defaultValue": "abfss://raw@adfstoragejpai.dfs.core.windows.net/@{pipeline().parameters.date}/patient_treatment.csv"
			},
			"target_path": {
				"type": "string",
				"defaultValue": "abfss://staging@adfstoragejpai.dfs.core.windows.net/@{pipeline().parameters.date}/patient_treatment.csv"
			}
		},
		"annotations": []
	}
}