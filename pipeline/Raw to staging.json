{
	"name": "Raw to staging",
	"properties": {
		"activities": [
			{
				"name": "Get Metadata1",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "raw_data",
						"type": "DatasetReference",
						"parameters": {
							"folderPath": {
								"value": "@concat('raw/',pipeline().parameters.SourceDate)",
								"type": "Expression"
							},
							"fileName": {
								"value": "@pipeline().parameters.FileName",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"columnCount"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"parameters": {
			"SourceDate": {
				"type": "string",
				"defaultValue": "2025-08-21"
			},
			"FileName": {
				"type": "string",
				"defaultValue": "patient_treatment.csv"
			}
		},
		"annotations": []
	}
}